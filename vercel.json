{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/story",
      "destination": "/api/index.js"
    },
    {
      "source": "/journal",
      "destination": "/api/index.js"
    },
    {
      "source": "/journal/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/blog",
      "destination": "/api/index.js"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/stealth-desk-14",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/download-menu",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
